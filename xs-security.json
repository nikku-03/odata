{
  "xsappname": "nikita-orders-app",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Employee",
      "description": "Employee Role"
    },
    {
      "name": "$XSAPPNAME.Manager",
      "description": "Manager Role"
    }
  ],
  "role-templates": [
    {
      "name": "Employee",
      "description": "Employee can view their own orders",
      "scope-references": [
        "$XSAPPNAME.Employee"
      ]
    },
    {
      "name": "Manager",
      "description": "Manager can view all orders and approve/reject",
      "scope-references": [
        "$XSAPPNAME.Manager"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "EmployeeRole",
      "description": "Employee Role Collection",
      "role-template-references": [
        "$XSAPPNAME.Employee"
      ]
    },
    {
      "name": "ManagerRole",
      "description": "Manager Role Collection",
      "role-template-references": [
        "$XSAPPNAME.Manager"
      ]
    }
  ],
  "attributes": []
}
